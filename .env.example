# Run python3 -m deploy.setup to generate .env and private service keys.
KINU_ENVIRONMENT=development
KINU_PUBLIC_URL=http://localhost:8080
KINU_SITE=:80
KINU_HTTP_PORT=8080
KINU_HTTPS_PORT=8443
KINU_RESEND_KEY=
KINU_EMAIL_SENDER=Kinu <noreply@example.com>

# Hosting OAuth apps. Register callbacks under KINU_PUBLIC_URL.
# /connections/vercel/callback and /connections/railway/callback
KINU_VERCEL_SLUG=
KINU_VERCEL_CLIENT_ID=
KINU_VERCEL_CLIENT_SECRET=
KINU_RAILWAY_CLIENT_ID=
KINU_RAILWAY_CLIENT_SECRET=

# Split frontend/backend hosting. Use the Firebase origin as KINU_PUBLIC_URL.
KINU_API_PUBLIC_URL=
KINU_COOKIE_SAMESITE=lax
