KINU_ENVIRONMENT=development
KINU_TELEMETRY_ENABLED=false
KINU_PUBLIC_URL=http://localhost:5173
# Keep this file in the API environment only.
KINU_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
# Use a Cognito public app client with ALLOW_USER_PASSWORD_AUTH and no client secret.
KINU_COGNITO_POOL_ID=
KINU_COGNITO_CLIENT_ID=
