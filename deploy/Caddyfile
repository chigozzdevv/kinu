{$KINU_SITE::80} {
    encode zstd gzip
    handle /_internal/* {
        respond 404
    }
    handle /_agent-native/* {
        reverse_proxy agent:8001
    }
    @api path /v1/* /auth/* /health/* /connections/* /browser-gateway/*
    handle @api {
        reverse_proxy api:8000
    }
    @assets path /assets/*
    handle @assets {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
}
