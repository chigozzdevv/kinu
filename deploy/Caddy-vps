{
    servers {
        trusted_proxies static private_ranges
        trusted_proxies_strict
    }
}

:80 {
    encode zstd gzip
    handle /_internal/* {
        respond 404
    }
    handle /_agent-native/* {
        reverse_proxy agent:8001
    }
    @api path /v1/* /auth/* /health/* /connections/* /browser-gateway/*
    handle @api {
        reverse_proxy api:8000
    }
    handle {
        redir {$KINU_PUBLIC_URL}{uri} 302
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
}
